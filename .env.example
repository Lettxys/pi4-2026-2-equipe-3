POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=isenta
POSTGRES_PORT=5432

BACKEND_PORT=3000
ASPNETCORE_ENVIRONMENT=Development

JWT_SECRET=troque-esta-chave-por-um-segredo-longo-com-no-minimo-32-caracteres
JWT_ISSUER=pi4-equipe-3
JWT_AUDIENCE=pi4-equipe-3-clients
JWT_EXPIRES_IN_MINUTES=60

# TTL do token de redefinição de senha devolvido pelo /api/auth/verify-code (em minutos).
# O código de 6 caracteres enviado por e-mail expira em 5 minutos (fixo no código).
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=10
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

REDIS_PORT=6379
REDIS_CONNECTION_STRING=localhost:6379

STORAGE_DIR=./storage

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP: enquanto SMTP_HOST estiver vazio, o backend apenas registra o conteúdo no log (nada é enviado).
# Sem SMTP configurado o e-mail com o código de redefinição não chega à caixa de entrada.
#
# Exemplo com Mailtrap (sandbox, ótimo para desenvolvimento):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=<seu usuário>
#   SMTP_PASSWORD=<sua senha>
#
# Exemplo com Gmail (precisa de uma "senha de app", não a senha da conta):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seu.email@gmail.com
#   SMTP_PASSWORD=<senha de app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@isenta.local

FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
